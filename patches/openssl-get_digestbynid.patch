diff --git a/openssl/crypto/asn1/a_verify.c b/openssl/crypto/asn1/a_verify.c
--- a/openssl/crypto/asn1/a_verify.c
+++ b/openssl/crypto/asn1/a_verify.c
@@ -116,2 +116,3 @@ int ASN1_item_verify_ctx(const ASN1_ITEM *it, const X509_ALGOR *alg,
     EVP_PKEY *pkey;
+    EVP_MD *fetched_type = NULL;
     unsigned char *buf_in = NULL;
@@ -183,2 +184,9 @@ int ASN1_item_verify_ctx(const ASN1_ITEM *it, const X509_ALGOR *alg,
                 type = EVP_get_digestbynid(mdnid);
+                if (type == NULL) {
+                    const char *mdname = OBJ_nid2sn(mdnid);
+
+                    if (mdname != NULL)
+                        fetched_type = EVP_MD_fetch(NULL, mdname, NULL);
+                    type = fetched_type;
+                }
                 if (type == NULL) {
@@ -224,2 +232,3 @@ int ASN1_item_verify_ctx(const ASN1_ITEM *it, const X509_ALGOR *alg,
 err:
+    EVP_MD_free(fetched_type);
     OPENSSL_clear_free(buf_in, inll);
diff --git a/openssl/crypto/x509/x509_set.c b/openssl/crypto/x509/x509_set.c
--- a/openssl/crypto/x509/x509_set.c
+++ b/openssl/crypto/x509/x509_set.c
@@ -216,2 +216,3 @@ static int x509_sig_info_init(X509_SIG_INFO *siginf, const X509_ALGOR *alg,
     int pknid, mdnid, md_size;
+    EVP_MD *fetched_md = NULL;
     const EVP_MD *md;
@@ -278,3 +279,11 @@ static int x509_sig_info_init(X509_SIG_INFO *siginf, const X509_ALGOR *alg,
         /* Security bits: half number of bits in digest */
-        if ((md = EVP_get_digestbynid(mdnid)) == NULL) {
+        md = EVP_get_digestbynid(mdnid);
+        if (md == NULL) {
+            const char *mdname = OBJ_nid2sn(mdnid);
+
+            if (mdname != NULL)
+                fetched_md = EVP_MD_fetch(NULL, mdname, NULL);
+            md = fetched_md;
+        }
+        if (md == NULL) {
             ERR_raise(ERR_LIB_X509, X509_R_ERROR_GETTING_MD_BY_NID);
@@ -283,5 +292,8 @@ static int x509_sig_info_init(X509_SIG_INFO *siginf, const X509_ALGOR *alg,
         md_size = EVP_MD_get_size(md);
-        if (md_size <= 0)
+        if (md_size <= 0) {
+            EVP_MD_free(fetched_md);
             return 0;
+        }
         siginf->secbits = md_size * 4;
+        EVP_MD_free(fetched_md);
         break;
